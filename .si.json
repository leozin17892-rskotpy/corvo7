{
  "plugin": "org.smartide.plugin.rust",
  "run": "cargo build",
  "gui": false,
  "intelligence": {
    ".json": {
      "enabled": true,
      "run": "vscode-json-language-server --stdio"
    },
    ".rs": {
      "enabled": true,
      "run": "rust-analyzer"
    },
    ".toml": {
      "enabled": true,
      "run": "taplo lsp stdio"
    },
    ".c": {
      "enabled": true,
      "run": "clangd"
    },
    ".md": {
      "enabled": true,
      "run": "marksman server"
    }
  }
}